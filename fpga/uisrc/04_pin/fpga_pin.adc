set_pin_assignment	{ O_hdmi_clk_p }	{ LOCATION = AA4; IOSTANDARD = LVDS18; }
set_pin_assignment	{ O_hdmi_tx_p[0] }	{ LOCATION = AB1; IOSTANDARD = LVDS18; }
set_pin_assignment	{ O_hdmi_tx_p[1] }	{ LOCATION = V3; IOSTANDARD = LVDS18; }
set_pin_assignment	{ O_hdmi_tx_p[2] }	{ LOCATION = W1; IOSTANDARD = LVDS18; }


set_pin_assignment	{ O_cam_scl }	{ LOCATION = Y21; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }	{ LOCATION = Y22; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
